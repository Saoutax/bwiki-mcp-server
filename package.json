{
    "name": "bwiki-mcp-server",
    "version": "1.1.0",
    "description": "MCP server for BWiki (wiki.biligame.com) with mandatory bilibili passport authentication",
    "license": "MIT",
    "bin": {
        "bwiki-mcp-server": "dist/bundle.cjs"
    },
    "files": [
        "dist/bundle.cjs",
        "config.example.json",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "main": "dist/bundle.cjs",
    "scripts": {
        "build": "pnpm run build:src && pnpm run bundle",
        "build:src": "tsc -p tsconfig.json",
        "bundle": "node scripts/bundle.mjs",
        "clean:dist": "node scripts/clean.mjs",
        "dev": "tsc -p tsconfig.json --watch",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "prepack": "pnpm run build",
        "start": "node dist/stdio.js",
        "test": "node scripts/smoke-stdio.mjs",
        "test:boot-session": "node scripts/probe-liveness.mjs",
        "test:guard": "node scripts/probe-liveness-guard.mjs",
        "test:writes": "node scripts/probe-writes.mjs",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@modelcontextprotocol/node": "^2.1.1",
        "@modelcontextprotocol/sdk": "^1.17.0",
        "@modelcontextprotocol/server": "^2.3.1",
        "ipaddr.js": "^1.9.1",
        "mwn": "^3.0.3",
        "node-fetch": "^3.3.2",
        "puppeteer-core": "^25.15.0",
        "types-mediawiki-api": "^2.1.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "esbuild": "^0.25.0",
        "oxfmt": "^0.78.0",
        "oxlint": "^1.93.0",
        "oxlint-tsgolint": "^7.0.2007",
        "typescript": "^5.9.2"
    },
    "engines": {
        "node": ">=22.12.0",
        "pnpm": ">=11"
    },
    "packageManager": "pnpm@12.6.0"
}
